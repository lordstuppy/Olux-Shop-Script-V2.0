# Copy to .env and fill in. Never commit .env.

APP_NAME="Digital Goods Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://shop.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file

# JSON lines in storage/logs/shop-YYYY-MM-DD.log
LOG_CHANNEL=json
LOG_LEVEL=info
LOG_DAILY_DAYS=30

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=

# Sessions: database driver, HttpOnly, SameSite=Lax, Secure.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Argon2id password hashing (defaults shown).
HASH_DRIVER=argon2id
ARGON_MEMORY=65536
ARGON_TIME=4
ARGON_THREADS=1

QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="shop@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Self-hosted Shkeeper (https://github.com/vsys-host/shkeeper.io)
SHKEEPER_BASE_URL=https://pay.example.com
SHKEEPER_API_KEY=
# Shkeeper signs callbacks (X-Shkeeper-Signature) with the API key: use the same value.
SHKEEPER_WEBHOOK_SECRET=
SHKEEPER_WEBHOOK_TOLERANCE=300
SHKEEPER_TIMEOUT=10
# Optional: public URL Shkeeper should call back if it differs from APP_URL routing.
SHKEEPER_CALLBACK_URL=
# Offered at checkout if Shkeeper's crypto list cannot be fetched.
SHKEEPER_CRYPTOS=BTC,LTC,ETH

SHOP_DEFAULT_CURRENCY=USD
SHOP_COMMISSION_BPS=1000
SHOP_PAYOUT_HOLD_DAYS=7
SHOP_MIN_PAYOUT_MINOR=1000
SHOP_ORDER_TTL_MINUTES=60
SHOP_DOWNLOAD_TTL_MINUTES=4320
SHOP_MAX_UPLOAD_KB=51200
SHOP_SUPPORT_EMAIL=support@example.com
SHOP_SECURITY_EMAIL=security@example.com
SHOP_HSTS_MAX_AGE=31536000

# Unpaid orders a buyer may hold at once.
SHOP_MAX_OPEN_ORDERS=3
SHOP_MAX_DOWNLOADS=10
SHOP_RENEWAL_REMINDER_DAYS=7
# Staff must use two-factor authentication for /admin.
SHOP_REQUIRE_STAFF_2FA=true
# Minutes a password confirmation stays valid for sensitive actions.
AUTH_PASSWORD_TIMEOUT=900

# Virus scanning of seller uploads: "required" (production) or "disabled" (development only).
SHOP_VIRUS_SCAN=required
CLAMAV_HOST=clamav
CLAMAV_PORT=3310

# Optional: only accept Shkeeper callbacks from these IPs/CIDRs (the HMAC is always checked).
SHKEEPER_WEBHOOK_ALLOWED_IPS=

# Bearer token for GET /metrics (empty disables the endpoint).
METRICS_TOKEN=

# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-* headers are trusted.
TRUSTED_PROXIES=
