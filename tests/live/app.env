APP_NAME="Live Test Shop"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://localhost:8443
LOG_CHANNEL=json
LOG_LEVEL=info
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=shop
DB_USERNAME=shop
DB_PASSWORD=live-db-pass
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
HASH_DRIVER=argon2id
QUEUE_CONNECTION=database
CACHE_STORE=database
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_FROM_ADDRESS="shop@example.test"
MAIL_FROM_NAME="Live Test Shop"
SHKEEPER_BASE_URL=http://127.0.0.1:8081
SHKEEPER_API_KEY=live-api-key-0123456789
SHKEEPER_WEBHOOK_SECRET=live-api-key-0123456789
SHKEEPER_CALLBACK_URL=http://127.0.0.1:8080/webhooks/shkeeper
SHKEEPER_PAYOUTS_ENABLED=true
SHKEEPER_PAYOUT_USERNAME=payout-user
SHKEEPER_PAYOUT_PASSWORD=payout-password
SHKEEPER_PAYOUT_FEES=BTC:10,LTC:10
SHKEEPER_PAYOUT_CALLBACK_URL=http://127.0.0.1:8080/webhooks/shkeeper/payouts
SHKEEPER_CRYPTOS=BTC,LTC,ETH
SHOP_DEFAULT_CURRENCY=USD
SHOP_VIRUS_SCAN=required
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
METRICS_TOKEN=live-metrics-token
TRUSTED_PROXIES=127.0.0.1
SHOP_REQUIRE_STAFF_2FA=true
